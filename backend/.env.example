# ── Banco de Dados (MySQL via Hostinger) ──────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=nome_do_banco
DB_USER=usuario_mysql
DB_PASS=senha_mysql

# ── Supabase (estoque + imagens) ──────────────────────────────────────────────
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=troque_por_uma_chave_segura_aleatoria

# ── App ───────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# URL pública deste servidor (sem barra no final)
# Usado para montar o link de download do APK
BACKEND_URL=https://seudominio.com.br

# Versão atual do APK disponível para download
APP_VERSION=1.0.2
